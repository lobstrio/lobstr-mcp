{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lobstrio/lobstr-mcp",
  "title": "lobstr.io",
  "description": "Web data API for your AI agents: one call, JSON back in seconds, the same fields every time.",
  "websiteUrl": "https://www.lobstr.io",
  "icons": [
    {
      "src": "https://www.lobstr.io/images/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://www.lobstr.io/images/favicon-512x512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/lobstrio/lobstr-mcp",
    "source": "github"
  },
  "version": "2.0.4",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.lobstr.io/v2/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer and your lobstr.io API key, from https://app.lobstr.io/dashboard/api",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
