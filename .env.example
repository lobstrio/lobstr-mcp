# Lobstr MCP configuration (copy to .env)

# Upstream Lobstr REST API
LOBSTR_API_BASE=https://api.lobstr.io/v1

# --- Local dev (no OAuth): the dev server authenticates as a single user ---
# Put a real Lobstr API token here to smoke-test against the live API.
LOBSTR_DEV_TOKEN=

# Behaviour
LOBSTR_REQUEST_TIMEOUT=30
LOBSTR_RUN_CONFIRM_THRESHOLD=100

# --- Production OAuth server (create_app) ---
# Public base URL the MCP is served from (used in OAuth/metadata).
LOBSTR_MCP_PUBLIC_URL=https://mcp.lobstr.io
# Shared secret the MCP presents to the additive Django grant endpoints
# (server-to-server). REQUIRED for the OAuth consent flow to work.
LOBSTR_MCP_SERVICE_CREDENTIAL=
# Lobstr frontend consent page the /authorize step redirects the browser to.
LOBSTR_CONSENT_URL=https://app.lobstr.io/connect-ai

# --- Persistence ---
# Without these the OAuth state lives in the process: a restart invalidates
# every issued token, drops registered OAuth clients, and forgets idempotency
# keys (so a repeated run can be charged twice). Set both for any real
# deployment. Use a Redis db of its own — Django's cache sits on db 0.
LOBSTR_MCP_REDIS_URL=
# Encrypts Lobstr API tokens at rest (required whenever REDIS_URL is set).
# Generate:
#   python -c "from lobstr_mcp.persistence import TokenCipher; print(TokenCipher.generate_key())"
LOBSTR_MCP_TOKEN_KEY=
